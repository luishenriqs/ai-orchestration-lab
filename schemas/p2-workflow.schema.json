{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-orchestration-lab.local/schemas/p2-workflow.schema.json","title":"Workflow","type":"object","additionalProperties":false,"required":["schema_version","workflow_id","contract_sha256","repository","baseline_git","worktree","state","phase","authorization_id","created_at","active_invocation_id","revision_cycles","correction_cycles"],"properties":{"schema_version":{"const":"2.0-p2"},"workflow_id":{"type":"string","minLength":1},"contract_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"repository":{"type":"string","minLength":1},"baseline_git":{"type":"string","pattern":"^[a-f0-9]{40,64}$"},"worktree":{"type":"string","minLength":1},"state":{"enum":["CREATED","AUTHORIZED","ACTIVE","AWAITING_APPROVAL","BLOCKED","CANCEL_REQUESTED","CANCELLED","REJECTED","FAILED","COMPLETED"]},"phase":{"enum":["NONE","PLANNING","REVIEWING","EXECUTING","VALIDATING"]},"authorization_id":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"active_invocation_id":{"type":["string","null"]},"revision_cycles":{"type":"integer","minimum":0},"correction_cycles":{"type":"integer","minimum":0}}}
