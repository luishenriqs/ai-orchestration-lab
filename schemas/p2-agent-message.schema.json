{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-orchestration-lab.local/schemas/p2-agent-message.schema.json","title":"AgentMessage","type":"object","additionalProperties":false,"required":["protocol_version","message_id","workflow_id","invocation_id","correlation_id","reply_to_message_id","source_event_id","source_cursor","sequence","message_type","payload","payload_sha256","observed_at","previous_event_hash","event_hash"],"properties":{"protocol_version":{"const":"2.0-p2"},"message_id":{"type":"string","minLength":1},"workflow_id":{"type":"string","minLength":1},"invocation_id":{"type":"string","minLength":1},"correlation_id":{"type":"string","minLength":1},"reply_to_message_id":{"type":["string","null"]},"source_event_id":{"type":["string","null"]},"source_cursor":{"type":["string","null"]},"sequence":{"type":"integer","minimum":1},"message_type":{"enum":["TASK_REQUEST","PLAN_RESULT","REVIEW_RESULT","CORRECTION_REQUEST","EXECUTION_RESULT","VALIDATION_RESULT","CONTROL_EVENT"]},"payload":{},"payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"observed_at":{"type":"string","format":"date-time"},"previous_event_hash":{"type":"string","minLength":1},"event_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
