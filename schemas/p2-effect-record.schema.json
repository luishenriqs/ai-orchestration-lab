{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-orchestration-lab.local/schemas/p2-effect-record.schema.json","title":"EffectRecord","type":"object","additionalProperties":false,"required":["schema_version","effect_id","workflow_id","invocation_id","operation","payload_sha256","state","created_at","observed_at"],"properties":{"schema_version":{"const":"2.0-p2"},"effect_id":{"type":"string","minLength":1},"workflow_id":{"type":"string","minLength":1},"invocation_id":{"type":"string","minLength":1},"operation":{"type":"string","minLength":1},"payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"state":{"enum":["INTENT_RECORDED","DISPATCHED","OBSERVED","UNKNOWN","RECONCILIATION_REQUIRED","CONFIRMED","BLOCKED"]},"created_at":{"type":"string","format":"date-time"},"observed_at":{"type":["string","null"],"format":"date-time"}}}
